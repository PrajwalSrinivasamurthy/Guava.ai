# Business-hours gate — see settings.PRACTICE_HOURS for the placeholder weekly table.
# PRACTICE_TZ=America/Chicago

# FAQ content, loaded via config_sheet.py. Leave unset to fall back to a fixed
# message in on_question. Once a real Sheet exists, set this and share it with the
# service account. Quote the tab name — `uv run --env-file` fails to parse an
# unquoted value containing spaces.
# FAQ_SPREADSHEET_ID=
# FAQ_SHEET_TAB="K12 FAQs"

# Test-only hours override (NOT the production mechanism) — "open" or "after".
# HOURS=open
