# Required
GUAVA_AGENT_NUMBER=+18065533554
GUAVA_LOCAL_API_KEY=

# Destination numbers — unset ends the call politely instead of transferring.
# LIVE_NUMBER=
# ELEVENLABS_NUMBER=+18884773057

# After-hours text-message link (empty disables the text option).
# CLA_AH_TEXT_URL=

# Business-hours gate — see settings.PRACTICE_HOURS for the placeholder weekly table.
# PRACTICE_TZ=America/Chicago

# Knowledge service (kb-service on the TTU server). With the URL and key set, the agent
# answers questions itself and drops the virtual-assistant choice; unset them (or set
# KB_ENABLED=false) to keep the previous flow.
# KB_SERVICE_URL=https://tosmonline0001.ttu.edu/cla-kb
# KB_API_KEY=
# KB_ENABLED=true
# KB_TIMEOUT_SECONDS=8

# FAQ content (config_sheet.py). Leave unset to fall back to a fixed message in
# on_question. Once a real Sheet exists, set this and share it with the service account.
# FAQ_SPREADSHEET_ID=
# FAQ_SHEET_TAB="CLA FAQs"

# Test-only hours override (NOT the production mechanism) — "open" or "after".
# HOURS=open
